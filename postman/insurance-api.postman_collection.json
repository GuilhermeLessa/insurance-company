	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"packages": {},
				"exec": [
					"const jar = pm.cookies.jar();",
					"",
					"const webUrl = pm.variables.get(\"webUrl\");",
					"",
					"jar.get(webUrl, \"XSRF-TOKEN\", (err, cookie) => {",
					"",
					"    console.log(err, cookie);",
					"",
					"    pm.request.addHeader({",
					"        key: \"X-XSRF-TOKEN\",",
					"        value: ''",
					"    })",
					"",
					"    pm.request.addHeader({",
					"        key: \"Referer\",",
					"        value: webUrl",
					"    })",
					"});"
				]
			}
